#include <Arduino.h>

#define LED_PIN LED_BUILTIN

void setup() {
  pinMode(LED_PIN, OUTPUT);
}

void loop() {
  digitalWrite(LED_PIN, HIGH);   // включить светодиод
  delayMicroseconds(1000);       // задержка 1мс
  digitalWrite(LED_PIN, LOW);    // выключить светодиод
  delayMicroseconds(1000);       // задержка 1мс
}